# Required for the secure partnership inquiry API and private file attachments.
# Use a MySQL-compatible connection URL. Never commit the real value.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required for the Vercel-compatible password-protected /dashboard mode.
# Use a unique, high-entropy value (at least 32 random bytes) for SESSION_SECRET.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required for Vercel deployments that must retain the existing 5 MB-per-file
# (25 MB total) attachment behavior. Configure a private S3-compatible bucket
# with browser PUT CORS for your deployed site origin. These stay server-side.
S3_BUCKET=peplogix-private-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-private-access-key
S3_SECRET_ACCESS_KEY=replace-with-private-secret-key
# Optional for Cloudflare R2, MinIO, or another S3-compatible provider.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Optional. Provide these only when intentionally using the existing Manus OAuth
# integration instead of the password mode above. Do not expose these to the browser.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_API_URL=
# MANUS_API_KEY=
# MANUS_API_BROWSER_KEY=
# OWNER_OPEN_ID=
